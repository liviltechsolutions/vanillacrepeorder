generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id              Int      @id @default(autoincrement())
  name            String
  avatar          String
  color           String
  photo           String?
  phone           String
  emergencyName   String?
  emergencyPhone  String?
  position        String
  skills          String[]
  ic              String?
}

model Booking {
  id         Int      @id @default(autoincrement())
  customer   String
  phone      String
  service    Int
  staff      Int
  date       String
  time       String
  status     String
  note       String?
  remark     String?
  payStatus  String
  payMethod  String?
  amtPaid    Int      @default(0)
  tip        Int      @default(0)
  txnId      String?
  seat       String?
  history    Json     @default("[]")
  products   Json     @default("[]")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int
  offerPrice  Int?
  discount    Int?
  inventory   Int      @default(0)
  category    String?
  image       String?
  createdAt   DateTime @default(now())
}

model LeaveRecord {
  id        Int      @id @default(autoincrement())
  staffId   Int
  dates     String[]
  leaveType String
  reason    String?
}

model Schedule {
  staffId Int  @id
  data    Json
}

model CustomerExtra {
  phone    String  @id
  ic       String?
  email    String?
  gender   String?
  birthday String?
}

model CustomerNote {
  phone String @id
  note  String
}

model ClosedDate {
  date   String  @id
  reason String?
}

model ClosedWeekday {
  weekday Int     @id
  reason  String?
}

model Service {
  id       Int    @id @default(autoincrement())
  name     String
  duration Int
  price    Int
}

model Settings {
  id               Int     @id @default(1)
  companyName      String
  location         String
  passwordHash     String
  passwordSalt     String
  notifyOnPending  Boolean @default(true)
  notifyBefore     Int     @default(30)
  contactPhone     String?
  address          String?
  personInCharge   String?
  facebook         String?
  instagram        String?
  tiktok           String?
  xhs              String?
  youtube          String?
  twitter          String?
  whatsapp         String?
  email            String?
  emailVerified    Boolean @default(false)
  emailVerifyToken String?
}
