generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id              Int      @id @default(autoincrement())
  merchantId      Int
  name            String
  avatar          String
  color           String
  photo           String?
  phone           String
  emergencyName   String?
  emergencyPhone  String?
  position        String
  skills          String[]
  ic              String?

  @@index([merchantId])
}

model Booking {
  id         Int      @id @default(autoincrement())
  merchantId Int
  customer   String
  phone      String
  service    Int
  staff      Int
  date       String
  time       String
  status     String
  note       String?
  remark     String?
  payStatus  String
  payMethod  String?
  amtPaid    Int      @default(0)
  tip        Int      @default(0)
  txnId      String?
  seat       String?
  history    Json     @default("[]")
  products   Json     @default("[]")

  @@index([merchantId])
}

model Product {
  id          Int      @id @default(autoincrement())
  merchantId  Int
  name        String
  description String?
  price       Int
  offerPrice  Int?
  discount    Int?
  inventory   Int      @default(0)
  category    String?
  image       String?
  createdAt   DateTime @default(now())

  @@index([merchantId])
}

model LeaveRecord {
  id         Int      @id @default(autoincrement())
  merchantId Int
  staffId    Int
  dates      String[]
  leaveType  String
  reason     String?

  @@index([merchantId])
}

model Schedule {
  merchantId Int
  staffId    Int
  data       Json

  @@id([merchantId, staffId])
}

model CustomerExtra {
  merchantId Int
  phone      String
  ic         String?
  email      String?
  gender     String?
  birthday   String?

  @@id([merchantId, phone])
}

model CustomerNote {
  merchantId Int
  phone      String
  note       String

  @@id([merchantId, phone])
}

model ClosedDate {
  merchantId Int
  date       String
  reason     String?

  @@id([merchantId, date])
}

model OpenOverride {
  merchantId Int
  date       String
  reason     String?

  @@id([merchantId, date])
}

model ClosedWeekday {
  merchantId Int
  weekday    Int
  reason     String?

  @@id([merchantId, weekday])
}

model Service {
  id         Int    @id @default(autoincrement())
  merchantId Int
  name       String
  duration   Int
  price      Int

  @@index([merchantId])
}

model Merchant {
  id               Int     @id @default(autoincrement())
  companyName      String
  location         String?
  businessType     String?
  passwordHash     String
  passwordSalt     String
  notifyOnPending  Boolean @default(true)
  notifyBefore     Int     @default(30)
  contactPhone     String?
  address          String?
  personInCharge   String?
  facebook         String?
  instagram        String?
  tiktok           String?
  xhs              String?
  youtube          String?
  twitter          String?
  whatsapp         String?
  email            String  @unique
  emailVerified    Boolean @default(false)
  emailVerifyToken String?
  seats            Json    @default("[]")
  createdAt        DateTime @default(now())
}
